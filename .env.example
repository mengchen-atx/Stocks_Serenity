# ─── AI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
AI_PROVIDER=openai              # openai | anthropic
AI_MODEL=gpt-4o                 # gpt-4o | claude-sonnet-4-6

# ─── Twitter/X ───────────────────────────────────────────────────────────────
TWITTER_BEARER_TOKEN=
TWITTER_USERNAME=serenity
TWITTER_INCLUDE_REPLIES=false
TWITTER_INCLUDE_RETWEETS=false
# Set to true to disable REST polling and receive tweets via stream-daemon instead.
# When true, stream-daemon.ts must be running on a separate always-on server.
TWITTER_STREAM_ENABLED=false

# ─── Stock Data ──────────────────────────────────────────────────────────────
FINNHUB_API_KEY=               # https://finnhub.io  (free tier OK)
ALPHA_VANTAGE_API_KEY=         # https://www.alphavantage.co (free tier OK)

# ─── Database ────────────────────────────────────────────────────────────────
# Supabase: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Railway:  postgresql://postgres:[password]@[host]:[port]/railway
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/serenity?schema=public

# ─── Push Channels ───────────────────────────────────────────────────────────
WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...
SERVER_CHAN_SENDKEY=            # Server酱 sendkey (optional)
WECHAT_TEMPLATE_ENDPOINT=      # Custom wechat template endpoint (optional)
TELEGRAM_BOT_TOKEN=            # @BotFather token
TELEGRAM_CHANNEL_ID=           # Channel ID, e.g. -100xxxxxxxxxx

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_...           # https://resend.com
EMAIL_FROM=Serenity Intelligence <noreply@yourdomain.com>
EMAIL_TO_OVERRIDE=             # Override all email recipients (dev/testing)

# ─── Auth (NextAuth) ─────────────────────────────────────────────────────────
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=              # Google OAuth2 client ID
GOOGLE_CLIENT_SECRET=          # Google OAuth2 client secret

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...  # or sk_test_... for development
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...   # ¥39/month price ID
STRIPE_PRICE_PRO=price_...     # ¥99/month price ID
STRIPE_PRICE_PREMIUM=price_... # ¥199/month price ID
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ─── App ─────────────────────────────────────────────────────────────────────
CRON_SECRET=change-me-strong-random-string
APP_BASE_URL=http://localhost:3000
APP_NAME=Serenity Intelligence
