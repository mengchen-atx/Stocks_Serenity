{
  "name": "serenity-ai-wechat-pusher",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "prisma:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "prisma:studio": "dotenv -e .env.local -- prisma studio",
    "cron:run": "DOTENV_CONFIG_PATH=.env.local tsx scripts/run-cron.ts",
    "test:push": "DOTENV_CONFIG_PATH=.env.local tsx scripts/test-push.ts",
    "test:push:format": "DOTENV_CONFIG_PATH=.env.local tsx scripts/test-push.ts --format",
    "test:push:real": "DOTENV_CONFIG_PATH=.env.local tsx scripts/test-push.ts --real",
    "backfill": "DOTENV_CONFIG_PATH=.env.local tsx scripts/backfill-yesterday.ts",
    "push:pending": "DOTENV_CONFIG_PATH=.env.local tsx scripts/push-pending.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@auth/prisma-adapter": "^2.11.2",
    "@google/generative-ai": "^0.24.1",
    "@notionhq/client": "^5.22.0",
    "@prisma/client": "^6.2.1",
    "@vercel/functions": "^3.6.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "jsonrepair": "^3.14.0",
    "next": "^15.1.4",
    "next-auth": "^4.24.14",
    "next-themes": "^0.4.6",
    "openai": "^4.77.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.60.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.4",
    "stripe": "^22.1.1",
    "tsx": "^4.19.2",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.4",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
